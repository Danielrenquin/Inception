DOMAIN_NAME=daniel.42.fr
DATA_PATH=/home/daniel/data

# MySQL Configuration
MYSQL_HOST=mariadb
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_ADMIN_USER=wp_manager

# Secrets (Docker secrets mounted in /run/secrets)
MYSQL_PASSWORD_FILE=/run/secrets/db_password
MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_root_password
MYSQL_ADMIN_PASSWORD_FILE=/run/secrets/db_admin_password

# WordPress Configuration
WP_URL=https://daniel.42.fr
WP_TITLE=SiteWordPress
WP_ADMIN_USER=admin_login
WP_ADMIN_PASSWORD_FILE=/run/secrets/wp_admin_password
WP_ADMIN_EMAIL=admin@example.com
